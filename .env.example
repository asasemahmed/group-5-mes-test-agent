# Copy this file to .env and fill in your own key. .env is ignored by git.

# Model access (OpenRouter). The key is only ever sent to https://openrouter.ai.
OPENROUTER_API_KEY=
LLM_MODEL=z-ai/glm-5.3-flash
# USD per million tokens, from the model's OpenRouter page (checked 2026-11-28).
# Used only when a response carries no cost of its own.
LLM_PRICE_INPUT_PER_MTOK=0.15
LLM_PRICE_OUTPUT_PER_MTOK=0.50
LLM_TEMPERATURE=0

# What the agent sends to the model: image (screenshot + element list) or text (element list only).
OBSERVATION_MODE=image

# Agent limits
MAX_AGENT_RETRIES=3
AGENT_MAX_STEPS=20
RUN_TIMEOUT_S=180
HEADLESS_MODE=true

# Benchmark
BENCHMARK_CONCURRENCY=3
BENCHMARK_REPEATS=5
BENCHMARK_MAX_COST_USD=5
